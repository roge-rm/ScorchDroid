 #if defined(_WIN32) && !defined(S3D_SERVER)
 	MessageBox( nullptr, newtext.c_str(), header.c_str(), MB_OK );
+#elif defined(__ANDROID__)
+	// printf() output isn't captured by logcat on Android.
+	__android_log_print(ANDROID_LOG_ERROR, "Scorched3D", "%s : %s", header.c_str(), newtext.c_str());
