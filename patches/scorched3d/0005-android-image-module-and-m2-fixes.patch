+// Android build: SDL_LoadBMP() replaced with a minimal reader for exactly
+// the case upstream itself requires (uncompressed 24bpp BMP) - SDL is not
+// part of this build, see the porting plan. BMP's on-disk layout (a
+// BITMAPFILEHEADER + BITMAPINFOHEADER, little-endian, bottom-up BGR rows,
+// each row padded to a 4-byte boundary) is simple/stable enough that a full
+// library isn't warranted just for this one format.
+namespace
+{
+	uint16_t readLE16(const unsigned char *p) { return (uint16_t) p[0] | ((uint16_t) p[1] << 8); }
+	uint32_t readLE32(const unsigned char *p)
+	{
+		return (uint32_t) p[0] | ((uint32_t) p[1] << 8) | ((uint32_t) p[2] << 16) | ((uint32_t) p[3] << 24);
+	}
+}
 
