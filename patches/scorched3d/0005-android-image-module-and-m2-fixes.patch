 #endif
@@ -87,11 +93,19 @@ void S3D::dialogAssert(const char *lineText, const int line, const char *file)
 	char buffer[20048];
 	snprintf(buffer, 20048, "%s\n%i:%s", lineText, line, file);
 	S3D::dialogMessage("Program Assert", buffer);
-	exit(64);
+	// Android build: abort() instead of exit() - exit() runs the whole
+	// process's atexit handlers/static destructors while other ART-owned
+	// threads (RenderThread, GC, ...) are still live, which corrupts ART's
+	// own internal state and crashes with a confusing, unrelated-looking
+	// "destroyed mutex" error on some other thread rather than this one.
+	// abort() skips all of that - still fatal, but doesn't touch anything
+	// outside this process's own signal handling.
+	abort();
 }
 
 void S3D::dialogExit(const std::string &header, const std::string &text, bool split)
 {
 	S3D::dialogMessage(header, text, split);
-	exit(64);
+	// See the Android build note in dialogAssert() above.
+	abort();
 }
