@@ -39,6 +39,9 @@
 	// explosion-sound trigger even though this whole path is normally
 	// client-only - see SoundEventQueue.h and the porting plan.
 	#include <SoundEventQueue.h>
+	// ... and the GLES3 renderer to the visual half, which is likewise
+	// client-only here - see EffectEventQueue.h.
+	#include <EffectEventQueue.h>
 #endif
 #include <landscapemap/DeformLandscape.hpp>
 #include <landscapemap/LandscapeMaps.hpp>
@@ -75,6 +78,27 @@ Explosion::~Explosion()
 
 void Explosion::init()
 {
+#ifdef S3D_SERVER
+	// Android build: the whole client body below draws the fireball via
+	// ParticleEmitter/ExplosionTextures. Raise one event with the size and
+	// the weapon's own <explosioncolour> instead and let the renderer own
+	// the look. getSize() is the same value the client body scales its
+	// particles by, before the WeapScale option multiplier which is a
+	// display preference this port does not expose yet.
+	{
+		FixedVector &colour = params_->getExplosionColor();
+		ScorchDroidEffects::EffectEvent effect;
+		effect.type = ScorchDroidEffects::eExplosion;
+		effect.x = position_[0].asFloat();
+		effect.y = position_[1].asFloat();
+		effect.z = position_[2].asFloat();
+		effect.size = params_->getSize().asFloat();
+		effect.r = colour[0].asFloat();
+		effect.g = colour[1].asFloat();
+		effect.b = colour[2].asFloat();
+		ScorchDroidEffects::push(effect);
+	}
+#endif
 #ifndef S3D_SERVER  // FIXME: whole function is client-only, use higher-level conditional compile
 	fixed multiplier     = fixed( ( (int)context_->getOptionsGame().getWeapScale() ) - OptionsGame::ScaleMedium );
 	multiplier          *= fixed( true, 5000 );
