+
 	totalTime_ += frameTime;
 
 	remove = (totalTime_ > laserTime_);
diff --git a/src/common/actions/Lightning.cpp b/src/common/actions/Lightning.cpp
index 508ee67d..224c8e1b 100644
--- a/src/common/actions/Lightning.cpp
+++ b/src/common/actions/Lightning.cpp
@@ -25,6 +25,11 @@
 	#include <sound/SoundUtils.hpp>
 	#include <GLEXT/GLCamera.hpp>
 	#include <sprites/ExplosionTextures.hpp>
+#else
+	// Android build: see EffectEventQueue.h - Lightning::draw() is
+	// client-only.
+	#include <EffectEventQueue.h>
+	#include <SoundEventQueue.h>
 #endif
 #include <target/TargetContainer.hpp>
 #include <target/TargetDamageCalc.hpp>
@@ -120,8 +125,45 @@ void Lightning::simulate(fixed frameTime, bool &remove)
 			}
 		}
 	}
+#else
+	// Android build: the weapon's own sound, once, as an event.
+	if (firstTime_)
+	{
+		firstTime_ = false;
+		if (weapon_->getSound() && 0 != strcmp("none", weapon_->getSound()))
+		{
+			ScorchDroidAudio::pushSoundEvent(S3D::getModFile(weapon_->getSound()));
+		}
+	}
 #endif // #ifndef S3D_SERVER
 
+#ifdef S3D_SERVER
+	// Android build: raise every arc once, on the first simulate - the
+	// segment list is built during init() and does not change afterwards,
+	// so the renderer gets the whole bolt in one go and fades it out over
+	// the same total time this action lives for.
+	if (firstTime_)
+	{
+		firstTime_ = false;
+		std::list<Segment>::iterator itor;
+		for (itor = segments_.begin(); itor != segments_.end(); ++itor)
+		{
+			Segment &segment = *itor;
+			ScorchDroidEffects::EffectEvent effect;
+			effect.type = ScorchDroidEffects::eLightning;
+			effect.x = segment.start[0].asFloat();
+			effect.y = segment.start[1].asFloat();
+			effect.z = segment.start[2].asFloat();
+			effect.endX = segment.end[0].asFloat();
+			effect.endY = segment.end[1].asFloat();
+			effect.endZ = segment.end[2].asFloat();
+			effect.size = segment.size.asFloat();
+			effect.r = 0.75f; effect.g = 0.85f; effect.b = 1.0f;
+			ScorchDroidEffects::push(effect);
+		}
+	}
+#endif
+
 	totalTime_ += frameTime;
 	remove = (totalTime_ > weapon_->getTotalTime());
 	Action::simulate(frameTime, remove);
diff --git a/src/common/actions/Napalm.cpp b/src/common/actions/Napalm.cpp
index 002724d9..7ce1e546 100644
--- a/src/common/actions/Napalm.cpp
+++ b/src/common/actions/Napalm.cpp
@@ -37,6 +37,10 @@
 	#include <landscape/DeformTextures.hpp>
 	#include <landscape/Smoke.hpp>
 	#include <client/ScorchedClient.hpp>
+#else
+	// Android build: see EffectEventQueue.h - the flame/smoke half of this
+	// action is client-only, so the renderer is fed events instead.
+	#include <EffectEventQueue.h>
 #endif
 #include <landscapemap/LandscapeMaps.hpp>
 #include <landscapedef/LandscapeDefinition.hpp>
@@ -176,6 +180,34 @@ void Napalm::simulate( fixed frameTime, bool& remove )
 	}
 #endif  // #ifndef S3D_SERVER
 
+#ifdef S3D_SERVER
+	// Android build: mirrors the client block above - pick one burning
+	// point per draw tick and raise a flame there, rather than one per
+	// point per frame, which would be hundreds of events a second for a
+	// large fire. counter_ is the same rate limiter the client uses.
+	if (!napalmPoints_.empty() && !params_->getNoSmoke() && counter_.nextDraw(frameTime.asFloat()))
+	{
+		NapalmEntry *entry = nullptr;
+		int count = rand() % napalmPoints_.size();
+		std::list<NapalmEntry *>::iterator itor;
+		for (itor = napalmPoints_.begin(); itor != napalmPoints_.end(); itor++, count--)
+		{
+			entry = *itor;
+			if (count <= 0) break;
+		}
+		if (entry != nullptr)
+		{
+			ScorchDroidEffects::EffectEvent effect;
+			effect.type = ScorchDroidEffects::eNapalm;
+			effect.x = float(entry->posX);
+			effect.y = float(entry->posY);
+			effect.z = getHeight(entry->posX, entry->posY).asFloat();
+			effect.size = 1.5f;
+			effect.r = 1.0f; effect.g = 0.55f; effect.b = 0.1f;
+			ScorchDroidEffects::push(effect);
+		}
+	}
+#endif
 
 	// Add napalm for the period of the time interval
 	// once the time interval has expired then start taking it away
