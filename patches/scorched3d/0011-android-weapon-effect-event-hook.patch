 		firstTime_ = false;
@@ -174,6 +183,27 @@ void Laser::simulate(fixed frameTime, bool &remove)
 		}
 	}
 
+#ifdef S3D_SERVER
+	// Android build: raise the beam once, after the loop above has walked
+	// it to its true stopping point (drawLength_ shortens when the beam is
+	// blocked by a shield), so the drawn beam ends where the real one did.
+	if (raiseEffect && drawLength_ > 0)
+	{
+		FixedVector end = position_ + direction_.Normalize() * drawLength_;
+		ScorchDroidEffects::EffectEvent effect;
+		effect.type = ScorchDroidEffects::eLaser;
+		effect.x = position_[0].asFloat();
+		effect.y = position_[1].asFloat();
+		effect.z = position_[2].asFloat();
+		effect.endX = end[0].asFloat();
+		effect.endY = end[1].asFloat();
+		effect.endZ = end[2].asFloat();
+		effect.size = hurtRadius_.asFloat();
+		effect.r = 1.0f; effect.g = 0.85f; effect.b = 0.85f;
+		ScorchDroidEffects::push(effect);
+	}
