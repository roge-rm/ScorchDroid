+void ActionController::getShotAndExplosionPositions(
+	std::vector<FixedVector> &shotPositions,
+	std::vector<FixedVector> &explosionPositions,
+	std::vector<unsigned int> *shotPlayerIds,
+	std::vector<FixedVector> *shotVelocities,
+	std::vector<WeaponProjectile *> *shotWeapons)
+{
+	for (int i = 0; i < actions_.actionCount; i++)
+	{
+		Action *action = actions_.actions[i];
+		if (action->getActionType() == "ShotProjectile")
+		{
+			ShotProjectile *shot = (ShotProjectile *) action;
+			shotPositions.push_back(shot->getPhysics().getPosition());
+			// Android port: which tank fired, so the renderer can use that
+			// tank's own projectile model (TankModel::getProjectileModelID)
+			// rather than one arbitrary model for every shot on the map.
+			if (shotPlayerIds) shotPlayerIds->push_back(shot->getPlayerId());
+			// ... and its velocity, so the renderer can point the
+			// projectile mesh along its actual flight path.
+			if (shotVelocities) shotVelocities->push_back(shot->getPhysics().getVelocity());
+			// ... and the weapon the shot itself holds. Upstream picks the
+			// projectile mesh from the weapon first and only falls back to
+			// the tank's own projectilemodel (see Accessory::getWeaponMesh),
+			// and the flame and smoke trails come from the same object
+			// (MissileActionRenderer), so the renderer needs it to match
+			// either.
+			//
+			// This is deliberately not the accessory's own action, which is
+			// what an earlier version of this passed back as an id. A
+			// weapon assembled out of other weapons - a WeaponMulti of
+			// missiles, an aimed-over wrapper - has an action that is not a
+			// WeaponProjectile at all, so casting it to one read a
+			// different class's memory as if it were this one. It survived
+			// while only bools were read out of it and aborted the moment
+			// something asked for the projectile scale, which is parsed
+			// from an expression.
+			if (shotWeapons) shotWeapons->push_back(shot->getWeapon());
+		}
+		else if (action->getActionType() == "Explosion")
+		{
+			explosionPositions.push_back(((Explosion *) action)->getPosition());
+		}
+	}
+}
+
+void ActionController::getRollerPositions(
+	std::vector<FixedVector> &positions,
+	std::vector<FixedVector4> &rotations,
+	std::vector<WeaponRoller *> &weapons,
+	std::vector<unsigned int> &playerIds)
+{
+	for (int i = 0; i < actions_.actionCount; i++)
+	{
+		Action *action = actions_.actions[i];
+		if (action->getActionType() != "ShotBounce") continue;
+
+		ShotBounce *roller = (ShotBounce *) action;
+		positions.push_back(roller->getPhysics().getPosition());
+		// Its own tumble, which is what upstream draws it with - see
+		// ShotBounce::draw's getRotationQuat.
+		rotations.push_back(roller->getPhysics().getRotationQuat());
+		// Carries the <rollermodel> and the scale, both of which the
+		// renderer needs and neither of which is on the action.
+		weapons.push_back(roller->getWeapon());
+		playerIds.push_back(roller->getPlayerId());
+	}
+}
