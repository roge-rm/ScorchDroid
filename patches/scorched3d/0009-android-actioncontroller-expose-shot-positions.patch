+void ActionController::getShotAndExplosionPositions(
+	std::vector<FixedVector> &shotPositions,
+	std::vector<FixedVector> &explosionPositions,
+	std::vector<unsigned int> *shotPlayerIds,
+	std::vector<FixedVector> *shotVelocities,
+	std::vector<unsigned int> *shotWeaponAccessoryIds)
+{
+	for (int i = 0; i < actions_.actionCount; i++)
+	{
+		Action *action = actions_.actions[i];
+		if (action->getActionType() == "ShotProjectile")
+		{
+			ShotProjectile *shot = (ShotProjectile *) action;
+			shotPositions.push_back(shot->getPhysics().getPosition());
+			// Android port: which tank fired, so the renderer can use that
+			// tank's own projectile model (TankModel::getProjectileModelID)
+			// rather than one arbitrary model for every shot on the map.
+			if (shotPlayerIds) shotPlayerIds->push_back(shot->getPlayerId());
+			// ... and its velocity, so the renderer can point the
+			// projectile mesh along its actual flight path.
+			if (shotVelocities) shotVelocities->push_back(shot->getPhysics().getVelocity());
+			// ... and the firing weapon's accessory id. Upstream picks the
+			// projectile mesh from the weapon first and only falls back to
+			// the tank's own projectilemodel (see Accessory::getWeaponMesh),
+			// so the renderer needs the weapon to match that precedence.
+			if (shotWeaponAccessoryIds)
+			{
+				Accessory *parent = shot->getWeapon() ? shot->getWeapon()->getParent() : nullptr;
+				shotWeaponAccessoryIds->push_back(parent ? parent->getAccessoryId() : 0);
+			}
+		}
+		else if (action->getActionType() == "Explosion")
+		{
+			explosionPositions.push_back(((Explosion *) action)->getPosition());
+		}
+	}
+}
