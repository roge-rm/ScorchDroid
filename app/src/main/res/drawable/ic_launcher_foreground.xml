<?xml version="1.0" encoding="utf-8"?>
<!-- Adapted from scorched3d-icon-1024.svg (project root) for the adaptive
     icon foreground layer: content scaled ~0.83 around the 120,120 center
     so the tank crosshairs stay inside the adaptive-icon safe zone, and
     dashed trajectory strokes simplified to solid (VectorDrawable has no
     stroke-dasharray equivalent). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="240"
    android:viewportHeight="240">
    <group
        android:pivotX="120"
        android:pivotY="120"
        android:scaleX="0.83"
        android:scaleY="0.83">

        <!-- Target rings -->
        <path
            android:strokeColor="#8E4128"
            android:strokeWidth="5"
            android:pathData="M62,120 a58,58 0 1,0 116,0 a58,58 0 1,0 -116,0" />
        <path
            android:strokeColor="#8E4128"
            android:strokeWidth="5"
            android:pathData="M78,120 a42,42 0 1,0 84,0 a42,42 0 1,0 -84,0" />
        <path
            android:strokeColor="#8E4128"
            android:strokeWidth="5"
            android:pathData="M94,120 a26,26 0 1,0 52,0 a26,26 0 1,0 -52,0" />
        <path
            android:fillColor="#C4623A"
            android:pathData="M110,120 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0" />

        <!-- Trajectory arcs -->
        <path
            android:strokeColor="#B8E04A"
            android:strokeWidth="8"
            android:strokeLineCap="round"
            android:pathData="M57,99 C 141,29 208,48 206,164" />
        <path
            android:strokeColor="#B8E04A"
            android:strokeWidth="8"
            android:strokeLineCap="round"
            android:pathData="M183,141 C 99,211 40,196 32,74" />

        <!-- Impact crosshairs -->
        <group android:translateX="206" android:translateY="166">
            <path
                android:strokeColor="#B8E04A"
                android:strokeWidth="5"
                android:strokeLineCap="round"
                android:pathData="M-9,-9 L9,9 M9,-9 L-9,9" />
        </group>
        <group android:translateX="32" android:translateY="72">
            <path
                android:strokeColor="#B8E04A"
                android:strokeWidth="5"
                android:strokeLineCap="round"
                android:pathData="M-9,-9 L9,9 M9,-9 L-9,9" />
        </group>

        <!-- Left tank -->
        <group android:translateX="32" android:translateY="120">
            <group android:rotation="-40">
                <path
                    android:strokeColor="#F2E4CF"
                    android:strokeWidth="7"
                    android:strokeLineCap="round"
                    android:pathData="M0,0 L33,0" />
            </group>
            <path
                android:fillColor="#F2E4CF"
                android:pathData="M-18,-15 h36 a9,9 0 0 1 9,9 v12 a9,9 0 0 1 -9,9 h-36 a9,9 0 0 1 -9,-9 v-12 a9,9 0 0 1 9,-9 z" />
            <path
                android:fillColor="#1B1424"
                android:pathData="M-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0" />
        </group>

        <!-- Right tank -->
        <group android:translateX="208" android:translateY="120">
            <group android:rotation="140">
                <path
                    android:strokeColor="#F2E4CF"
                    android:strokeWidth="7"
                    android:strokeLineCap="round"
                    android:pathData="M0,0 L33,0" />
            </group>
            <path
                android:fillColor="#F2E4CF"
                android:pathData="M-18,-15 h36 a9,9 0 0 1 9,9 v12 a9,9 0 0 1 -9,9 h-36 a9,9 0 0 1 -9,-9 v-12 a9,9 0 0 1 9,-9 z" />
            <path
                android:fillColor="#1B1424"
                android:pathData="M-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0" />
        </group>
    </group>
</vector>
