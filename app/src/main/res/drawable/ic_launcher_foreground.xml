<?xml version="1.0" encoding="utf-8"?>
<!-- Adapted from design/icons/scorchdroid-icon-1024.svg for the adaptive
     icon foreground layer.

     Two deliberate differences from the source SVG:
     - Content is scaled to 0.70 around the 120,120 centre so the outlying
       tanks (and their barrels) stay inside the adaptive-icon safe zone -
       only the middle ~67% of the layer is guaranteed visible once a
       launcher applies its mask.
     - The trajectory arc is solid rather than dashed; VectorDrawable has no
       equivalent of SVG's stroke-dasharray.

     The SVG's dark background rect isn't reproduced here - that's the
     background layer's job (ic_launcher_background.xml, same #1B1424). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="240"
    android:viewportHeight="240">

    <group
        android:pivotX="120"
        android:pivotY="120"
        android:scaleX="0.70"
        android:scaleY="0.70">

        <!-- Matches the source SVG's outer <g transform="translate(-2 -10)">. -->
        <group
            android:translateX="-2"
            android:translateY="-10">

            <!-- Explosion: concentric blast rings, darkest outermost. -->
            <path
                android:fillColor="#5E2B1E"
                android:pathData="M64,126 a58,58 0 1,0 116,0 a58,58 0 1,0 -116,0 Z" />
            <path
                android:fillColor="#8E4128"
                android:pathData="M75,119 a42,42 0 1,0 84,0 a42,42 0 1,0 -84,0 Z" />
            <path
                android:fillColor="#C4623A"
                android:pathData="M86,112 a26,26 0 1,0 52,0 a26,26 0 1,0 -52,0 Z" />
            <path
                android:fillColor="#D98A5C"
                android:pathData="M97,105 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0 Z" />

            <!-- Target ring. -->
            <path
                android:fillColor="#1B1424"
                android:pathData="M126,148 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0 Z" />
            <path
                android:strokeColor="#C4623A"
                android:strokeWidth="5"
                android:pathData="M128.5,148 a17.5,17.5 0 1,0 35,0 a17.5,17.5 0 1,0 -35,0 Z" />

            <!-- Shot trajectory (dashes flattened to a solid stroke). -->
            <path
                android:strokeColor="#B8E04A"
                android:strokeWidth="8"
                android:strokeLineCap="round"
                android:pathData="M69,76 C100,92 116,112 134,136" />

            <!-- Three tanks: barrel first, then hull over its base, then cupola. -->
            <group
                android:translateX="40"
                android:translateY="60">
                <group android:rotation="28">
                    <path
                        android:strokeColor="#F2E4CF"
                        android:strokeWidth="7"
                        android:strokeLineCap="round"
                        android:pathData="M0,0 L33,0" />
                </group>
                <path
                    android:fillColor="#F2E4CF"
                    android:pathData="M-9,-15 h18 a9,9 0 0 1 9,9 v12 a9,9 0 0 1 -9,9 h-18 a9,9 0 0 1 -9,-9 v-12 a9,9 0 0 1 9,-9 Z" />
                <path
                    android:fillColor="#1B1424"
                    android:pathData="M-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 Z" />
            </group>

            <group
                android:translateX="204"
                android:translateY="84">
                <group android:rotation="158">
                    <path
                        android:strokeColor="#F2E4CF"
                        android:strokeWidth="7"
                        android:strokeLineCap="round"
                        android:pathData="M0,0 L33,0" />
                </group>
                <path
                    android:fillColor="#F2E4CF"
                    android:pathData="M-9,-15 h18 a9,9 0 0 1 9,9 v12 a9,9 0 0 1 -9,9 h-18 a9,9 0 0 1 -9,-9 v-12 a9,9 0 0 1 9,-9 Z" />
                <path
                    android:fillColor="#1B1424"
                    android:pathData="M-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 Z" />
            </group>

            <group
                android:translateX="74"
                android:translateY="208">
                <group android:rotation="-52">
                    <path
                        android:strokeColor="#F2E4CF"
                        android:strokeWidth="7"
                        android:strokeLineCap="round"
                        android:pathData="M0,0 L33,0" />
                </group>
                <path
                    android:fillColor="#F2E4CF"
                    android:pathData="M-9,-15 h18 a9,9 0 0 1 9,9 v12 a9,9 0 0 1 -9,9 h-18 a9,9 0 0 1 -9,-9 v-12 a9,9 0 0 1 9,-9 Z" />
                <path
                    android:fillColor="#1B1424"
                    android:pathData="M-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 Z" />
            </group>
        </group>
    </group>
</vector>
