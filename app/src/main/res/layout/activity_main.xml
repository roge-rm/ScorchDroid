<?xml version="1.0" encoding="utf-8"?>
<!-- M4: the overlay UI (status/HUD, Shop/weapon buttons, elevation
     control) is now real Compose (see GameHud.kt), not plain XML views -
     this layout is just the GL surface plus a single ComposeView covering
     it. See the porting plan for why this replaces the earlier M4
     stopgap. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <android.opengl.GLSurfaceView
        android:id="@+id/game_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/hud_compose_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
