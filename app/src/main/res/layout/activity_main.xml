<?xml version="1.0" encoding="utf-8"?>
<!-- M4: the overlay UI (status/HUD, Shop/weapon buttons, elevation
     control) is now real Compose (see GameHud.kt), not plain XML views -
     this layout is just the GL surface plus a single ComposeView covering
     it. See the porting plan for why this replaces the earlier M4
     stopgap. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- M9: the GL surface is created in code and added here when a game
         starts, then removed again on quit-to-menu. A fresh GLSurfaceView per
         game means a fresh EGL context, which means nativeOnSurfaceCreated
         runs and the renderer's whole build-once cache (terrain, textures,
         models, trees) is rebuilt for the new landscape - reusing the reset
         path the minimise/resume bug already forced us to get right, instead
         of writing a second one. The menu screens have no GL surface at all. -->
    <FrameLayout
        android:id="@+id/game_surface_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/hud_compose_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
