<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- M5: LAN hosting/joining over real sockets (NetServerTCP3 - see
         engine_jni.cpp's startLocalGame/connectToHost) needs plain INTERNET
         even for local-network traffic; ACCESS_WIFI_STATE is for reading
         this device's LAN IP to show/share for "connect by IP" (see
         MainActivity.getLocalIpAddress). CHANGE_WIFI_MULTICAST_STATE backs
         the MulticastLock LanDiscovery holds while NSD registration/
         discovery is active - some OEM Wi-Fi stacks otherwise drop the
         mDNS multicast traffic NSD depends on. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Wi-Fi Direct peer-to-peer play (see WifiDirectTransport.kt): devices
         form their own group with no router, no hotspot and no internet, and
         the game then runs over the same sockets a LAN game uses.
         CHANGE_WIFI_STATE is what actually lets the app form and join a
         group. Discovering peers needs a runtime permission whose shape
         changed in API 33 - before that the framework treated finding nearby
         devices as a location capability and demanded ACCESS_FINE_LOCATION,
         which is why that one is capped at 32; from 33 there is a dedicated
         NEARBY_WIFI_DEVICES, declared neverForLocation because the game does
         not want, derive or keep the player's location. Wi-Fi Direct is
         required="false" so the game still installs on hardware without it -
         every entry point checks WifiDirectTransport.isSupported. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />

    <uses-feature
        android:name="android.hardware.wifi.direct"
        android:required="false" />

    <!-- Bluetooth play (see BluetoothTransport.kt): the last way in, and the
         only one that needs no Wi-Fi at all. The permission shape was
         rearranged in API 31 - before it, scanning was a location capability
         and BLUETOOTH/BLUETOOTH_ADMIN covered the rest, which is why those
         are capped at 30 and ACCESS_FINE_LOCATION (declared above for Wi-Fi
         Direct) is capped at 32. From 31 there are three dedicated
         permissions, and BLUETOOTH_SCAN is declared neverForLocation because
         the game does not want, derive or keep the player's location.
         Bluetooth is required="false" like Wi-Fi Direct - every entry point
         checks BluetoothTransport.isSupported. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScorchDroid">

        <!-- M11: rotation must not recreate this Activity.
             Without configChanges a rotation destroys and rebuilds it, which
             resets the UI to the menu while the *engine* keeps running in
             native globals that outlive the Activity - so the game in progress
             is orphaned and the next one is refused outright with "engine
             already started". The GLSurfaceView handles the resize itself and
             Compose re-lays-out on its own, so there is nothing to rebuild
             anyway. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>