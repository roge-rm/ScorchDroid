# Copy to .env and edit. docker compose reads it automatically.

# Required. The web admin can kick, ban and rewrite every server setting,
# so it refuses to start without one.
ADMIN_PASSWORD=change-me

# What players see in their Join Game list, and what the server calls
# itself in chat. This names the server the first time it starts, when the
# config file is created; after that the Settings page owns the name, so
# renaming it there sticks.
SERVER_NAME=ScorchDroid

# 27270 is what every ScorchDroid and desktop Scorched3D client tries
# first. Changing it means players have to type "address:port".
GAME_PORT=27270

# The admin page.
WEB_PORT=8080
# 127.0.0.1 to keep it to this machine (reach it over an SSH tunnel).
WEB_BIND=0.0.0.0

# Publish the server on the LAN so phones find it without typing an
# address. Needs host networking, which docker-compose.yml uses by default.
LAN_DISCOVERY=1

# Set to 1 only if a reverse proxy in front of the admin page terminates
# TLS. It marks the session cookie Secure, which breaks plain HTTP.
HTTPS=0
