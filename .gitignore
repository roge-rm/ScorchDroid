*.iml
.gradle
/local.properties

# Android Studio's per-machine project state, all of it. None of it is shared:
# it holds this box's JDK name, the device picked from the deploy dropdown and
# the local VCS mappings.
/.idea/
.DS_Store
/build
/host-tests/build
/captures
.externalNativeBuild
.cxx
local.properties

# Release signing material. The keystore and the credentials in
# local.properties must never be committed - a signing key in a public
# repository is the key compromised.
*.jks
*.keystore

# Dedicated server: the operator's own secrets and the Python bytecode the
# web admin leaves behind. .env.example is the tracked template.
/.env
__pycache__/
